# ===========================================================================
# Educonnect backend — local configuration
#
# Running via Docker Compose? The backend image in docker-compose.yml reads the
# DB/auth vars from THIS file (or a root `.env` / shell env) and sets DB_HOST=db.
# The Docker host-side PostgreSQL port is controlled by PG_HOST_PORT
# (default 5432) — see the root .env.example. DB_PORT below is only used by
# local (non-Docker) runs with `make dev`.
# Copy this file to `.env` and adjust.
# ===========================================================================

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eduverse

# Authentication
# In production, this should be a long random string (e.g. generated by `openssl rand -hex 32`)
SECRET_KEY=super_secret_eduverse_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours