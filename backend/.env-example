# ===========================================================================
# Educonnect backend — local configuration
#
# Running via Docker Compose? The backend image in docker-compose.yml reads the
# DB/auth vars from THIS file (or a root `.env` / shell env) and sets DB_HOST=db.
# The Docker host-side PostgreSQL port is controlled by PG_HOST_PORT
# (default 5432) — see the root .env.example. DB_PORT below is only used by
# local (non-Docker) runs with `make dev`.
# Copy this file to `.env` and adjust.
# ===========================================================================

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eduverse

<<<<<<< Updated upstream
# Authentication
# In production, this should be a long random string (e.g. generated by `openssl rand -hex 32`)
SECRET_KEY=super_secret_eduverse_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours
# ---- AI / LLM (local, Phase 2) ----
# Ollama se Qwen 2.5:  ollama pull qwen2.5   (phir local server: ollama serve)
# NOTE: model ka tag exactly wahi likho jo `ollama list` dikhata hai.
=======
# A full DSN wins over the parts above - paste the Supabase URI as-is here.
DATABASE_URL_OVERRIDE=
# `require` for Supabase and any managed Postgres; leave empty locally.
DB_SSLMODE=
# The deployed database, used only by `make db-supabase` and the CI drift job.
# Leave it empty on a laptop that has only the local database.
SUPABASE_DB_URL=

# Log every SQL statement. Off unless you are debugging.
SQL_ECHO=0

# ---- Auth -------------------------------------------------------------------
# Generate a real one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser. List every
# frontend you deploy (Netlify URL, custom domain, ...).
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000
# Preview/branch deploys allowed by pattern. "" disables pattern matching.
CORS_ORIGIN_REGEX=^https:\/\/([a-zA-Z0-9_-]+\.)?netlify\.app$

# ---- Seed data --------------------------------------------------------------
# The demo roll (students + staff) is off by default - leave both unset for a
# database with real data only, or uncomment them to fill demo rows.
# SEED_DEMO_DATA=1
# The password every demo student / teacher / guardian account gets (read only
# when the demo roll runs).
# SEED_DEMO_PASSWORD=demo@1234
# Platform (`system_admin`) account. The passwords are only read when the account
# does not exist yet, so an already-seeded database needs neither.
SEED_PLATFORM_ADMIN_LOGIN=admin
SEED_PLATFORM_ADMIN_PASSWORD=
# Shared password for the schools' first admin accounts (scripts/seed.py).
SEED_SCHOOL_ADMIN_PASSWORD=

# ---- AI / LLM ---------------------------------------------------------------
# Local: `ollama pull qwen2.5` then `ollama serve`. The model tag must match
# `ollama list` exactly. Switching to OpenAI/Gemini = these four values only.
>>>>>>> Stashed changes
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama      # Ollama ko token nahi chahiye; placeholder hai
LLM_MODEL=qwen2.5:latest
LLM_TEMPERATURE=0.3     # generation (rigid)
LLM_JUDGE_TEMPERATURE=0.1   # quality check (judge ko creative nahi hona)
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=180     # local model ka pehla token slow — cloud se zyada timeout
LLM_MAX_RETRIES=2
# Difficulty/Bloom ka default mix (Easy/Medium/Hard aur Remember/Understand/Apply/Analyze)
DIFFICULTY_MIX=30/50/20
BLOOM_MIX=20/40/30/10

# ---- Embeddings (Phase 3) ----
# Free HuggingFace Inference API token banao: https://huggingface.co/settings/tokens
EMBEDDING_PROVIDER=hf
HUGGINGFACE_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
VECTOR_COLLECTION_PREFIX=edu_school_   # Qdrant tenant isolation

# ---- Queue / async jobs (Phase 3) ----
REDIS_URL=redis://localhost:6379/0
GENERATION_QUEUE=paper_generation

# ---- Object storage / files (Phase 3) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=educonnect