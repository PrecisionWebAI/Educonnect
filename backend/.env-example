# ============================================================================
# Educonnect — backend reference configuration (NO SECRETS IN THIS FILE)
#
# Copy to `backend/.env` and fill in the blanks:
#
#     cp backend/.env-example backend/.env
#
# Deployed / Supabase values: `backend/.env.production` (git-ignored).
#
# `backend/.env` is git-ignored and is read by the API, Alembic, the seeds and
# `docker compose` (the compose project directory is `backend/`). This file is
# the tracked inventory of every variable the system understands — add a new
# setting here first, then use it.
#
#   ENVIRONMENT=local        laptop (the DB is still the Supabase project)
#   ENVIRONMENT=staging      deployed
#   ENVIRONMENT=production   deployed
#
# Anything but `local` refuses to start with the placeholder SECRET_KEY.
# ============================================================================

# ---- Which environment these values describe --------------------------------
ENVIRONMENT=local

# ---- Database ---------------------------------------------------------------
# ONE database everywhere: the Supabase project. Paste the dashboard URI here
# (session pooler, port 5432) and both the laptop and the deployment use it.
DATABASE_URL_OVERRIDE=
# `require` for Supabase and any managed Postgres.
DB_SSLMODE=require
DB_SCHEMA=public

# The parts below are read only when DATABASE_URL_OVERRIDE is empty - a Postgres
# you run yourself. Leave them empty otherwise: there is no local server to fall
# back to.
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432
# DB_NAME=

# The same database named again, read by `make db-supabase` / `--target supabase`
# and the CI drift job. Normally identical to DATABASE_URL_OVERRIDE.
SUPABASE_DB_URL=

# Log every SQL statement. Off unless you are debugging.
SQL_ECHO=0

# ---- Auth -------------------------------------------------------------------
# Generate a real one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser. List every
# frontend you deploy (Netlify URL, custom domain, ...).
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000
# Preview/branch deploys allowed by pattern. "" disables pattern matching.
CORS_ORIGIN_REGEX=^https:\/\/([a-zA-Z0-9_-]+\.)?netlify\.app$

# ---- Seed data --------------------------------------------------------------
# Platform (`system_admin`) account. The passwords are only read when the account
# does not exist yet, so an already-seeded database needs neither.
SEED_PLATFORM_ADMIN_LOGIN=admin
SEED_PLATFORM_ADMIN_PASSWORD=
# Shared password for the schools' first admin accounts (scripts/02_seed.py).
SEED_SCHOOL_ADMIN_PASSWORD=
# Shared password for the manual demo data (make seed-roll). Empty => the script's
# published fallback. Nothing at boot reads this.
SEED_DEMO_PASSWORD=

# ---- AI / LLM ---------------------------------------------------------------
# Local: `ollama pull qwen2.5` then `ollama serve`. The model tag must match
# `ollama list` exactly. Switching to OpenAI/Gemini = these four values only.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:latest
LLM_TEMPERATURE=0.3
LLM_JUDGE_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
# Default Easy/Medium/Hard and Remember/Understand/Apply/Analyze+ mix.
DIFFICULTY_MIX=30/50/20
BLOOM_MIX=20/40/30/10
# Bounded repair loop for paper generation: how many times a failed slot is
# retried, and whether a second LLM call judges each question.
EXAMS_REPAIR_PASSES=1
EXAMS_USE_LLM_JUDGE=1

# ---- Embeddings -------------------------------------------------------------
# dummy (offline, deterministic) | ollama (nomic-embed-text) | hf (token needed)
EMBEDDING_PROVIDER=dummy
# Free token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=16
VECTOR_COLLECTION_PREFIX=edu_school_

# ---- RAG / vector store -----------------------------------------------------
# QDRANT_URL empty -> embedded local mode (QDRANT_LOCAL_PATH); set -> server mode.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=.qdrant_local
VECTOR_TENANT=default
RAG_ENABLED=1
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.0
CHUNK_SIZE=800
CHUNK_OVERLAP=100
ANTI_REPEAT_LOOKBACK=60

# ---- OCR (opt-in; needs tesseract or a vision model) ------------------------
OCR_ENABLED=0
OCR_PROVIDER=none
OCR_LANGUAGE=eng
OCR_MAX_CHARS=8000

# ---- Uploads ----------------------------------------------------------------
UPLOAD_DIR=.uploads
UPLOAD_MAX_MB=25
URL_FETCH_MAX_KB=2048
URL_FETCH_TIMEOUT=20

# ---- Queue / async jobs -----------------------------------------------------
REDIS_URL=redis://localhost:6379/0
GENERATION_QUEUE=paper_generation

# ---- Object storage ---------------------------------------------------------
# Credentials are secrets: no defaults in the code, set them here when MinIO is
# actually used.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=educonnect

# ============================================================================
# SUPABASE (managed Postgres) — the only database
#
# Paste the dashboard URI into DATABASE_URL_OVERRIDE, keep DB_SSLMODE=require and
# `make db-sync` applies every migration and runs the boot seeds against it. The
# same file works for a laptop: `ENVIRONMENT=local` only relaxes the checks that
# belong to a deployed process (CORS, the placeholder SECRET_KEY).
#
#   DATABASE_URL_OVERRIDE=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Port 5432 = session/direct (use this for Alembic). Port 6543 = transaction
# pooler (`?pgbouncer=true`), which does not support the DDL Alembic needs.
#
# There is no local Postgres any more: the compose `db` service and its volume
# were removed, and `docker-entrypoint.sh` waits on this DSN's host:port.
# ============================================================================
