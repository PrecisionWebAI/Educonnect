# ===========================================================================
# Educonnect backend — local configuration
#
# Running via Docker Compose? The backend image in docker-compose.yml reads the
# DB/auth vars from THIS file (or a root `.env` / shell env) and sets DB_HOST=db.
# The Docker host-side PostgreSQL port is controlled by PG_HOST_PORT
# (default 5432) — see the root .env.example. DB_PORT below is only used by
# local (non-Docker) runs with `make dev`.
# Copy this file to `.env` and adjust.
# ===========================================================================

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eduverse

# Authentication
# In production, this should be a long random string (e.g. generated by `openssl rand -hex 32`)
SECRET_KEY=super_secret_eduverse_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours
# ---- AI / LLM (local, Phase 2) ----
# Ollama se Qwen 2.5:  ollama pull qwen2.5:7b   (phir local server: ollama serve)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama      # Ollama ko token nahi chahiye; placeholder hai
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.3     # generation (rigid)
LLM_JUDGE_TEMPERATURE=0.1   # quality check (judge ko creative nahi hona)

# ---- Embeddings (Phase 3) ----
# Free HuggingFace Inference API token banao: https://huggingface.co/settings/tokens
EMBEDDING_PROVIDER=hf
HUGGINGFACE_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
VECTOR_COLLECTION_PREFIX=edu_school_   # Qdrant tenant isolation

# ---- Queue / async jobs (Phase 3) ----
REDIS_URL=redis://localhost:6379/0
GENERATION_QUEUE=paper_generation

# ---- Object storage / files (Phase 3) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=educonnect