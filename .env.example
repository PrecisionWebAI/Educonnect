# =============================================================================
# Educonnect — Docker Compose overrides (optional, NO SECRETS)
#
# `docker compose` reads `backend/.env` for everything the stack needs — the
# database credentials, `SECRET_KEY`, the LLM settings and the seed switches all
# live there (see `backend/.env-example` for the full inventory).
#
# This file is only for the host-side knobs below, and is optional: every one of
# them has a default in `backend/docker-compose.yml`.
#
#     cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# PORTS
# -----------------------------------------------------------------------------
# Host port mapped to PostgreSQL inside the container. If your machine already
# runs PostgreSQL on 5432, change this (e.g. PG_HOST_PORT=5433). Inside the
# compose network PostgreSQL always listens on 5432.
PG_HOST_PORT=5432

# Host port mapped to the FastAPI container (http://localhost:8000/docs)
API_PORT=8000

# -----------------------------------------------------------------------------
# CONTAINER-NETWORK OVERRIDES
# -----------------------------------------------------------------------------
# `backend/.env` says `DB_HOST=localhost` because that is where YOUR MACHINE
# finds Postgres; inside the compose network the database is the `db` service.
# Only set these if you split the stack differently.
# DB_HOST_DOCKER=db
# DB_PORT_DOCKER=5432
# Ollama runs on the host, not in the container.
# LLM_BASE_URL_DOCKER=http://host.docker.internal:11434/v1

# -----------------------------------------------------------------------------
# STARTUP
# -----------------------------------------------------------------------------
# How long the entrypoint waits for PostgreSQL before starting anyway. Compose
# already gates on the db healthcheck; this is the safety net for slow boots.
DB_WAIT_SECONDS=60

# -----------------------------------------------------------------------------
# DEMO DATA
# -----------------------------------------------------------------------------
# Overrides the `SEED_DEMO_DATA` in `backend/.env` *for the compose stack only*.
# Leave it commented to keep whatever `backend/.env` says (1 by default).
#   SEED_DEMO_DATA=1   fill the demo roll
#   SEED_DEMO_DATA=0   no demo students / staff
# SEED_DEMO_DATA=1
