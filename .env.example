# =============================================================================
# Educonnect — Docker Compose overrides (optional, NO SECRETS)
#
# `docker compose` reads `backend/.env` for everything the stack needs —
# `DATABASE_URL_OVERRIDE` (the Supabase DSN), `SECRET_KEY`, the LLM settings and
# the seed switches all live there (see `backend/.env-example` for the full
# inventory). There is no database container, so nothing here describes one.
#
# This file is only for the host-side knobs below, and is optional: every one of
# them has a default in `backend/docker-compose.yml`.
#
#     cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# PORTS
# -----------------------------------------------------------------------------
# Host port mapped to the FastAPI container (http://localhost:8000/docs)
API_PORT=8000

# -----------------------------------------------------------------------------
# CONTAINER-NETWORK OVERRIDES
# -----------------------------------------------------------------------------
# The database is Supabase, reachable from inside the container exactly as it is
# from the host — so `backend/.env` needs no override for it.
# Ollama runs on the host, not in the container.
# LLM_BASE_URL_DOCKER=http://host.docker.internal:11434/v1

# -----------------------------------------------------------------------------
# STARTUP
# -----------------------------------------------------------------------------
# How long the entrypoint waits for the database at the DSN's host:port before
# starting anyway. Supabase is usually up; this is the safety net for a cold
# pooler or a dead network.
DB_WAIT_SECONDS=60

