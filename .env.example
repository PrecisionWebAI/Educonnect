# ===========================================================================
# Educonnect — Docker Compose overrides (optional)
#
# `docker compose` reads, in order of priority: shell env vars, a root `.env`
# file next to this file, then `backend/.env`. The backend DB/auth vars
# (DB_USER, DB_PASSWORD, DB_NAME, SECRET_KEY, ...) already come from
# `backend/.env`, so you typically only need THIS file for port overrides.
# ===========================================================================

# Host port mapped to PostgreSQL inside the container. If your machine
# already runs PostgreSQL on 5432, change this (e.g. PG_HOST_PORT=5433).
PG_HOST_PORT=5432

# --- API -------------------------------------------------------------------
# Host port mapped to the FastAPI container (http://localhost:8000/docs)
<<<<<<< Updated upstream
API_PORT=8000
=======
API_PORT=8000

# -----------------------------------------------------------------------------
# CONTAINER-NETWORK OVERRIDES
# -----------------------------------------------------------------------------
# `backend/.env` says `DB_HOST=localhost` because that is where YOUR MACHINE
# finds Postgres; inside the compose network the database is the `db` service.
# Only set these if you split the stack differently.
# DB_HOST_DOCKER=db
# DB_PORT_DOCKER=5432
# Ollama runs on the host, not in the container.
# LLM_BASE_URL_DOCKER=http://host.docker.internal:11434/v1

# -----------------------------------------------------------------------------
# STARTUP
# -----------------------------------------------------------------------------
# How long the entrypoint waits for PostgreSQL before starting anyway. Compose
# already gates on the db healthcheck; this is the safety net for slow boots.
DB_WAIT_SECONDS=60

# -----------------------------------------------------------------------------
# DEMO DATA
# -----------------------------------------------------------------------------
# Overrides `SEED_DEMO_DATA` *for the compose stack only*. Off by default: no
# demo students / staff are written unless you set it to 1 here or in
# `backend/.env`.
#   SEED_DEMO_DATA=1   fill the demo roll (its accounts use demo@1234)
#   SEED_DEMO_DATA=0   no demo students / staff (default)
# SEED_DEMO_DATA=0
