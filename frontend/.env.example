# =============================================================================
# Educonnect frontend — reference configuration (NO SECRETS)
#
# Copy to `frontend/.env.local` (git-ignored) and adjust:
#
#     cp frontend/.env.example frontend/.env.local
#
# `NEXT_PUBLIC_*` values are inlined into the browser bundle at BUILD time, so
# they are public by definition — never put a secret here, and rebuild after
# changing one (a running dev server picks it up, a deployed build does not).
# =============================================================================

# The API this browser talks to. It must be reachable from the USER'S machine,
# not from the machine running `next build` — so it is the public URL of the
# backend, never a docker-internal hostname.
#
#   local development : http://localhost:8000
#   deployed          : https://<your-backend-host>
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: the chat WebSocket, when it is served from somewhere other than the
# API host. Empty = derived from NEXT_PUBLIC_API_BASE_URL (http -> ws).
NEXT_PUBLIC_WS_BASE_URL=
